{
  "name": "@pavo-dev/cli",
  "version": "0.1.4",
  "description": "PAVO CLI with canvas, media-generation, and short-drama skills",
  "bin": {
    "pavo": "scripts/run.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "test": "node tests/version-check.test.js && node tests/skills.test.js && node tests/install-wizard.test.js && go test ./... && go vet ./..."
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maoshuhua/pavo-cli.git"
  },
  "license": "MIT",
  "files": [
    "cmd",
    "internal",
    "skills",
    "scripts/install.js",
    "scripts/install-wizard.js",
    "scripts/platform.js",
    "scripts/run.js",
    "scripts/skills.js",
    "scripts/version-check.js",
    "checksums.txt",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
